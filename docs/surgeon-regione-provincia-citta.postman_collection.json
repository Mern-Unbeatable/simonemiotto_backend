{
  "info": {
    "name": "Surgeon Regione-Provincia-Citta API",
    "description": "Postman collection for testing auth, admin CRUD, and public suggestion/search APIs with Regione > Provincia > Citta hierarchy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "4f40e6d6-87f8-4f7a-9f12-c8972fd7f3c2"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1) Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const accessToken = json?.data?.tokens?.accessToken || json?.data?.accessToken;",
                  "if (accessToken) pm.collectionVariables.set('adminToken', accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2) Surgeon Register (multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Dr. Example Surgeon", "type": "text" },
                { "key": "email", "value": "{{surgeonEmail}}", "type": "text" },
                { "key": "password", "value": "{{surgeonPassword}}", "type": "text" },
                { "key": "phone", "value": "+8801700000000", "type": "text" },
                { "key": "regionId", "value": "{{regionId}}", "type": "text" },
                { "key": "provinceId", "value": "{{provinceId}}", "type": "text" },
                { "key": "cityId", "value": "{{cityId}}", "type": "text" },
                { "key": "clinicId", "value": "{{clinicId}}", "type": "text" },
                { "key": "specialization", "value": "{{specialization}}", "type": "text" },
                { "key": "experienceYears", "value": "8", "type": "text" },
                { "key": "address", "value": "Demo address", "type": "text" },
                { "key": "bio", "value": "Demo profile bio", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/surgeon-profiles"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json?.data || {};",
                  "if (data?.id) pm.collectionVariables.set('profileId', data.id);",
                  "const token = data?.tokens?.accessToken || data?.accessToken;",
                  "if (token) pm.collectionVariables.set('surgeonToken', token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3) Surgeon Profile Update",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{surgeonToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Dr. Updated Name", "type": "text" },
                { "key": "regionId", "value": "{{regionId}}", "type": "text" },
                { "key": "provinceId", "value": "{{provinceId}}", "type": "text" },
                { "key": "cityId", "value": "{{cityId}}", "type": "text" },
                { "key": "clinicId", "value": "{{clinicId}}", "type": "text" },
                { "key": "specialization", "value": "{{specialization}}", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/surgeon-profiles/update/{{profileId}}"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Regione",
          "item": [
            {
              "name": "Create Regione",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Lombardia\"\n}"
                },
                "url": "{{baseUrl}}/regioni"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();",
                      "const id = json?.data?.id;",
                      "if (id) pm.collectionVariables.set('regionId', id);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Update Regione",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Lombardia Updated\"\n}"
                },
                "url": "{{baseUrl}}/regioni/{{regionId}}"
              }
            },
            {
              "name": "Delete Regione",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "url": "{{baseUrl}}/regioni/{{regionId}}"
              }
            }
          ]
        },
        {
          "name": "Provincia",
          "item": [
            {
              "name": "Create Provincia",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Milano\",\n  \"regionId\": \"{{regionId}}\"\n}"
                },
                "url": "{{baseUrl}}/province"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();",
                      "const id = json?.data?.id;",
                      "if (id) pm.collectionVariables.set('provinceId', id);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Update Provincia",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Milano Updated\",\n  \"regionId\": \"{{regionId}}\"\n}"
                },
                "url": "{{baseUrl}}/province/{{provinceId}}"
              }
            },
            {
              "name": "Delete Provincia",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "url": "{{baseUrl}}/province/{{provinceId}}"
              }
            }
          ]
        },
        {
          "name": "City",
          "item": [
            {
              "name": "Create Citta",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Milano Centro\",\n  \"provinceId\": \"{{provinceId}}\"\n}"
                },
                "url": "{{baseUrl}}/citta"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();",
                      "const id = json?.data?.id;",
                      "if (id) pm.collectionVariables.set('cityId', id);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Update Citta",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Milano Centro Updated\",\n  \"provinceId\": \"{{provinceId}}\"\n}"
                },
                "url": "{{baseUrl}}/citta/{{cityId}}"
              }
            },
            {
              "name": "Delete Citta",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "url": "{{baseUrl}}/citta/{{cityId}}"
              }
            }
          ]
        },
        {
          "name": "Clinic",
          "item": [
            {
              "name": "Create Clinic",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Milano Prime Clinic\",\n  \"cityId\": \"{{cityId}}\"\n}"
                },
                "url": "{{baseUrl}}/clinics"
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();",
                      "const id = json?.data?.id;",
                      "if (id) pm.collectionVariables.set('clinicId', id);"
                    ],
                    "type": "text/javascript"
                  }
                }
              ]
            },
            {
              "name": "Update Clinic",
              "request": {
                "method": "PATCH",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Milano Prime Clinic Updated\",\n  \"cityId\": \"{{cityId}}\"\n}"
                },
                "url": "{{baseUrl}}/clinics/{{clinicId}}"
              }
            },
            {
              "name": "Delete Clinic",
              "request": {
                "method": "DELETE",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "url": "{{baseUrl}}/clinics/{{clinicId}}"
              }
            }
          ]
        },
        {
          "name": "Get All Locations",
          "item": [
            {
              "name": "Get Location Tree For Admin Dashboard",
              "request": {
                "method": "GET",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{adminToken}}" }
                ],
                "url": "{{baseUrl}}/regioni/dashboard-tree"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Public",
      "item": [
        {
          "name": "1) Regione Suggestion",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/regioni?search=lom"
          }
        },
        {
          "name": "2) Provincia Suggestion By Regione",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/province?regionId={{regionId}}&search=mil"
          }
        },
        {
          "name": "3) Citta Suggestion By Provincia",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/citta?provinceId={{provinceId}}&search=mil"
          }
        },
        {
          "name": "4) Clinic Suggestion By Citta",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/clinics?cityId={{cityId}}&search=cli"
          }
        },
        {
          "name": "5) Specializations",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/surgeon-profiles/specializations?search=plas&limit=20"
          }
        },
        {
          "name": "6) Search Surgeons By Hierarchy + Clinic",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/surgeon-profiles/search?regionId={{regionId}}&provinceId={{provinceId}}&cityId={{cityId}}&clinicId={{clinicId}}&specialization={{specialization}}&search=Dr"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "adminEmail", "value": "admin@example.com" },
    { "key": "adminPassword", "value": "Password123!" },
    { "key": "surgeonEmail", "value": "surgeon@example.com" },
    { "key": "surgeonPassword", "value": "Password123!" },
    { "key": "adminToken", "value": "" },
    { "key": "surgeonToken", "value": "" },
    { "key": "regionId", "value": "" },
    { "key": "provinceId", "value": "" },
    { "key": "cityId", "value": "" },
    { "key": "clinicId", "value": "" },
    { "key": "profileId", "value": "" },
    { "key": "specialization", "value": "Plastic Surgery" }
  ]
}
